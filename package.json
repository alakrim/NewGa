{
  "name": "bannerfall",
  "version": "0.1.0",
  "description": "Bannerfall: a 2.5D online hero brawler / tower defense. 20 heroes, monster waves, capturable banners.",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external",
    "start": "node dist/server.js",
    "typecheck": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "validate": "tsx tools/validate-content.ts",
    "assets:fetch": "node tools/fetch-assets.mjs",
    "assets:build": "node tools/build-assets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alakrim/NewGa.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alakrim/NewGa/issues"
  },
  "homepage": "https://github.com/alakrim/NewGa#readme",
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.9.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "meshoptimizer": "^1.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "private": true,
  "type": "module"
}
