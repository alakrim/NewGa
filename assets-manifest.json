{
  "about": "Where every art, audio and font file in the repo comes from, and under what licence. Checked by `python3 tools/assets.py lint` (CI) and turned into CREDITS.md by `python3 tools/assets.py credits`. First matching entry wins. New art enters the repo only with an entry here.",
  "allowed_licences": [
    "CC0-1.0",
    "CC-BY-3.0",
    "CC-BY-4.0",
    "OFL-1.1",
    "project",
    "ai-generated"
  ],
  "roots": [
    "godot/assets",
    "godot/paintover",
    "public/assets",
    "public/icons",
    "docs/concepts",
    "docs/art-tests"
  ],
  "skip": [
    "**/*.import",
    "**/*.md",
    "**/*.gd",
    "**/*.uid",
    "**/*.tscn",
    "**/*.gdshader",
    "**/*.py",
    "**/*.json",
    "**/*.txt",
    "**/*.bin"
  ],
  "forbidden": [
    {
      "glob": "godot/assets/tinyswords_free/**",
      "why": "Tiny Swords Free Pack: free for commercial use but may not be redistributed. Fetched by tools/fetch-tinyswords.mjs, never committed."
    }
  ],
  "entries": [
    {
      "glob": "godot/assets/tinyswords/**",
      "name": "Tiny Swords (Update 010)",
      "author": "Pixel Frog",
      "url": "https://pixelfrog-assets.itch.io/tiny-swords",
      "licence": "CC0-1.0",
      "notes": "The older CC0 upload. The newer Free Pack is not redistributable; see forbidden."
    },
    {
      "glob": "godot/assets/kaykit/**",
      "name": "KayKit Medieval Hexagon Pack",
      "author": "Kay Lousberg",
      "url": "https://kaylousberg.itch.io/kaykit-medieval-hexagon",
      "licence": "CC0-1.0"
    },
    {
      "glob": "public/assets/env/**",
      "name": "KayKit Medieval Hexagon Pack",
      "author": "Kay Lousberg",
      "url": "https://kaylousberg.itch.io/kaykit-medieval-hexagon",
      "licence": "CC0-1.0",
      "notes": "Fetched by tools/fetch-assets.mjs from github.com/KayKit-Game-Assets."
    },
    {
      "glob": "public/assets/characters/Skeleton_*",
      "name": "KayKit Character Pack: Skeletons",
      "author": "Kay Lousberg",
      "url": "https://kaylousberg.itch.io/kaykit-skeletons",
      "licence": "CC0-1.0"
    },
    {
      "glob": "public/assets/skeleton-weapons/**",
      "name": "KayKit Character Pack: Skeletons",
      "author": "Kay Lousberg",
      "url": "https://kaylousberg.itch.io/kaykit-skeletons",
      "licence": "CC0-1.0"
    },
    {
      "glob": "public/assets/characters/**",
      "name": "KayKit Character Pack: Adventurers",
      "author": "Kay Lousberg",
      "url": "https://kaylousberg.itch.io/kaykit-adventurers",
      "licence": "CC0-1.0"
    },
    {
      "glob": "godot/assets/icons/**",
      "name": "game-icons.net icons (rendered to PNG)",
      "author": "Lorc, Delapouite",
      "url": "https://game-icons.net",
      "licence": "CC-BY-3.0",
      "credit": "Icons made by Lorc and Delapouite, from game-icons.net, CC BY 3.0. Per-icon list: public/icons/LICENSE.md."
    },
    {
      "glob": "public/icons/**",
      "name": "game-icons.net icons",
      "author": "Lorc, Delapouite",
      "url": "https://game-icons.net",
      "licence": "CC-BY-3.0",
      "credit": "Icons made by Lorc and Delapouite, from game-icons.net, CC BY 3.0. Per-icon list: public/icons/LICENSE.md."
    },
    {
      "glob": "godot/assets/fonts/**",
      "name": "Pixelify Sans",
      "author": "The Pixelify Sans Project Authors",
      "url": "https://github.com/eifetx/Pixelify-Sans",
      "licence": "OFL-1.1"
    },
    {
      "glob": "godot/assets/hd2d/**",
      "name": "HD-2D ground cover",
      "author": "Bannerfall project",
      "licence": "project",
      "notes": "Generated by tools/mkgrass.py."
    },
    {
      "glob": "godot/paintover/guides/**",
      "name": "Paint-over block-map guides",
      "author": "Bannerfall project",
      "licence": "project",
      "notes": "Rendered by godot/paintover/capture.tscn."
    },
    {
      "glob": "godot/paintover/depth/sketch.png",
      "name": "Paint-over zone sketch",
      "author": "Bannerfall project",
      "licence": "project",
      "notes": "godot/paintover/depth/sketch.py."
    },
    {
      "glob": "godot/paintover/depth/height_preview.png",
      "name": "Paint-over height preview",
      "author": "Bannerfall project",
      "licence": "project",
      "notes": "godot/paintover/depth/fit.py (Depth Anything V2 Small, Apache-2.0 model, output not covered by it)."
    },
    {
      "glob": "godot/paintover/**/shots/**",
      "name": "Paint-over screenshots",
      "author": "Bannerfall project",
      "licence": "project"
    },
    {
      "glob": "godot/paintover/**",
      "name": "Paint-over paintings, concepts and buildings",
      "author": "Bannerfall project",
      "licence": "ai-generated",
      "generator": "Muse Image, Seedream 5.0 Flash (OpenRouter)",
      "prompts": "tools/paintover.py, tools/paintover_concepts.py, godot/paintover/depth/paint.py, godot/paintover/buildings/paint.py"
    },
    {
      "glob": "docs/concepts/**",
      "name": "Art-direction concepts",
      "author": "Bannerfall project",
      "licence": "ai-generated",
      "generator": "Gemini 3 Pro Image (OpenRouter); see docs/concepts/README.md"
    },
    {
      "glob": "docs/art-tests/**",
      "name": "Sprite bake tests and mock-ups",
      "author": "Bannerfall project",
      "licence": "project",
      "notes": "tools/bake-sprites.ts renders of the KayKit CC0 characters."
    }
  ]
}
